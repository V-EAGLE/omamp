{
  "schemaVersion": 1,
  "id": "io.github.v-eagle.omamp",
  "name": "OmAmp",
  "version": "2.0.0",
  "author": "Vincenz Adler",
  "description": "OmAmp — a music player for the Omarchy bar: works with any MPRIS player (Spotify, Tidal, Amazon Music, Audible, YouTube Music, web players…) and adds queue, library and search for Apple Music",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Player.qml"
  },
  "barWidget": {
    "displayName": "OmAmp",
    "description": "Now playing, controls, timeline and source switching for any player; Up Next and a full library for Apple Music",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "maxLabelWidth": 180,
      "appleMusic": true
    },
    "schema": [
      {
        "key": "maxLabelWidth",
        "type": "integer",
        "label": "Max title width (px)",
        "min": 0,
        "max": 600,
        "step": 10,
        "defaultValue": 180
      },
      {
        "key": "appleMusic",
        "type": "boolean",
        "label": "Apple Music integration (queue, library, search)",
        "defaultValue": true
      }
    ]
  },
  "license": "MIT",
  "repository": "https://github.com/V-EAGLE/omamp"
}
